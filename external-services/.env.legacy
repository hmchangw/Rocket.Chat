# Legacy 2-Service Architecture Environment Variables  
# Use this for backward compatibility with existing websocket-aggregator setup

# MongoDB Configuration
MONGO_URL=mongodb://localhost:27018/meteor?directConnection=true

# NATS Configuration
EXTERNAL_WATCHER_NATS_URL=nats://localhost:4222

# LEGACY: WebSocket Aggregator URL (deprecated but supported)
EXTERNAL_WATCHER_WS_URL=ws://localhost:8083/ws

# Enable external services with legacy mode
USE_EXTERNAL_DBWATCHER=true
USE_HORIZONTAL_BROADCAST_SERVICE=false

# Enable legacy WebSocket in aggregator
AGGREGATOR_ENABLE_WEBSOCKET=true

# Service Health Check URLs  
DBWATCHER_HEALTH_URL=http://localhost:8082/health
AGGREGATOR_HEALTH_URL=http://localhost:8084/health

# Architecture Mode
EXTERNAL_ARCHITECTURE_MODE=legacy  # 3services or legacy