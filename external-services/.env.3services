# 3-Service Architecture Environment Variables
# Use this for the new decoupled architecture with separate broadcast service

# MongoDB Configuration
MONGO_URL=mongodb://localhost:27018/meteor?directConnection=true

# NATS Configuration  
EXTERNAL_WATCHER_NATS_URL=nats://localhost:4222

# NEW: Horizontal Broadcast Service WebSocket URL (recommended)
EXTERNAL_WATCHER_WS_URL=ws://localhost:8086/ws
EXTERNAL_WATCHER_BROADCAST_URL=http://localhost:8087

# Enable external services
USE_EXTERNAL_DBWATCHER=true
USE_HORIZONTAL_BROADCAST_SERVICE=true

# Service Health Check URLs
DBWATCHER_HEALTH_URL=http://localhost:8082/health
AGGREGATOR_HEALTH_URL=http://localhost:8084/health
BROADCAST_HEALTH_URL=http://localhost:8087/health

# Architecture Mode
EXTERNAL_ARCHITECTURE_MODE=3services  # 3services or legacy